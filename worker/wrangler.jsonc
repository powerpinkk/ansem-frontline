{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ansem-frontline-stream",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "durable_objects": {
    "bindings": [
      { "name": "STREAM_HUB", "class_name": "StreamHub" }
    ]
