  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StreamHub"] }
  ],
  "vars": {
    "TOKEN_MINT": "9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump",
    "ALLOWED_ORIGIN": "https://ansem-frontline.vercel.app"
  }
}
