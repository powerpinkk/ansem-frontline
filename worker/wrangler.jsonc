{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ansem-frontline-stream",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_HUB",
        "class_name": "StreamHub"
      },
      {
        "name": "GLOBAL_BUDGET",
        "class_name": "GlobalBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StreamHub"
      ]
    },
    {
      "tag": "v2-global-budget",
      "new_sqlite_classes": [
        "GlobalBudget"
      ]
    }
  ],
  "vars": {
    "WORKER_BUILD_ID": "frontline-2d-portfolio",
    "ALLOWED_ORIGINS": "https://ansem-frontline.vercel.app,https://frontline-solana.vercel.app,https://powerpinkk.github.io",
    "LIVE_TOKEN_MINTS": "9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"
  }
}
