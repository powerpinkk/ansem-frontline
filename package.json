{
  "name": "ansem-frontline",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Near-real-time 3D visualization of verified Solana token swaps.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:tokens:smoke": "node scripts/token-smoke.mjs",
    "test:m5:smoke": "node scripts/m5-live-smoke.mjs",
    "test:soak": "node scripts/soak-test.mjs",
    "test:terrain:soak": "node --expose-gc scripts/market-terrain-soak.mjs",
    "test:locomotion:soak": "node scripts/locomotion-soak.mjs",
    "test:combat:soak": "node scripts/combat-soak.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
