{
  "name": "frontline",
  "version": "3.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Solana token activity and price in an illustrated 2D battlefield, with an offline synthetic demo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:checks && playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e && npm run check:bundle",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "build:checks": "node scripts/build-candidates.mjs",
    "check:bundle": "node scripts/check-candidate.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "three": "0.185.1",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
