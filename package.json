{
  "name": "ansem-frontline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Near-real-time 3D visualization of verified $ANSEM swaps on Solana.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:soak": "node scripts/soak-test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
